// Zod schemas in src/domain/schemas are the source of truth for JSON columns
// and string enums. Every read of a Json column is parsed with Zod in src/server/repo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Apartment {
  id            String   @id @default(uuid()) @db.Uuid
  /// Supabase auth.users.id
  userId        String   @db.Uuid
  name          String
  address       String
  city          String
  /// ISO 3166-1 alpha-2
  country       String   @db.Char(2)
  lat           Float?
  lng           Float?
  floorLevel    Int
  /// "rent" | "own"
  tenure        String
  totalAreaM2   Float
  yearBuilt     Int?
  /// Direction of north, clockwise degrees from plan "up"
  northAngleDeg Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rooms         Room[]
  profile       UserProfile?

  @@index([userId])
}

model Room {
  id                       String    @id @default(uuid()) @db.Uuid
  apartmentId              String    @db.Uuid
  apartment                Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  name                     String
  /// RoomType enum, see src/domain/schemas/room.ts
  type                     String
  /// Point[] in cm, clockwise, y-down
  polygon                  Json
  ceilingHeight            Int
  /// Opening[]
  openings                 Json      @default("[]")
  /// FixedElement[]
  fixedElements            Json      @default("[]")
  /// Record<wallIndex, Cardinal>
  wallOrientationOverrides Json      @default("{}")
  sortOrder                Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  designs                  Design[]

  @@index([apartmentId])
}

/// Style profile, one per apartment (see src/domain/schemas/profile.ts)
model UserProfile {
  id             String    @id @default(uuid()) @db.Uuid
  apartmentId    String    @unique @db.Uuid
  apartment      Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  /// Household
  household      Json
  /// Record<roomId, EUR>
  budgetPerRoom  Json      @default("{}")
  /// QuizAnswer[]
  quizAnswers    Json      @default("[]")
  /// Record<StyleKey, number>, derived on the server from quizAnswers
  styleScores    Json      @default("{}")
  /// Hex[]
  colorsLiked    Json      @default("[]")
  /// Hex[]
  colorsDisliked Json      @default("[]")
  /// MustKeepItem[]
  mustKeep       Json      @default("[]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Dated cache for external data (geocoding, climate, trends)
model ContextCache {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  /// "geocode" | "climate" | "trends"
  kind      String
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([kind])
}

/// One row per Claude API call, for token and cost tracking
model LlmCall {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  apartmentId       String?  @db.Uuid
  purpose           String
  model             String
  promptId          String
  promptVersion     String
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  cacheReadTokens   Int      @default(0)
  cacheWriteTokens  Int      @default(0)
  webSearchRequests Int      @default(0)
  costEstimateEur   Float    @default(0)
  durationMs        Int
  /// "ok" | "error"
  status            String
  error             String?
  /// Set after the design produced by this call is saved
  designId          String?  @db.Uuid
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([designId])
}

/// Fixed-window rate limiting (one row per counted action)
model RateLimitHit {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  bucket    String
  createdAt DateTime @default(now())

  @@index([userId, bucket, createdAt])
}

/// One row per design version of a room (see src/domain/schemas/design.ts)
model Design {
  id              String   @id @default(uuid()) @db.Uuid
  roomId          String   @db.Uuid
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  version         Int
  parentVersion   Int?
  /// DesignContent
  content         Json
  /// { status, issues, repairAttempts }
  validation      Json
  /// "valid" | "valid_with_warnings" | "invalid"
  status          String
  /// { model, promptId, promptVersion }
  source          Json
  costEstimateEur Float    @default(0)
  durationMs      Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([roomId, version])
}
